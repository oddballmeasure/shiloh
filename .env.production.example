# Copy to .env.production on the VPS, fill all values, then chmod 600 it.
DOMAIN=learn.example.com
ACME_EMAIL=ops@example.com

MONGO_DB_NAME=korean_study
MONGO_ROOT_USERNAME=replace-with-a-uri-safe-username
MONGO_ROOT_PASSWORD=replace-with-a-long-uri-safe-password
# URL-encode username/password if they contain reserved URI characters.
MONGO_URL=mongodb://replace-with-a-uri-safe-username:replace-with-a-long-uri-safe-password@mongodb:27017/korean_study?authSource=admin

JWT_SECRET=replace-with-at-least-32-random-bytes
INTERNAL_AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_DISCORD_ID=your-production-discord-client-id
AUTH_DISCORD_SECRET=your-production-discord-client-secret

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-mini
OCR_LANGUAGES=kor,eng
ASSIGNMENT_PDF_MAX_BYTES=52428800

# Used only by ops/backup-mongodb.sh and ops/restore-mongodb.sh.
BACKUP_AGE_RECIPIENT=age1replace-with-your-public-recipient
BACKUP_AGE_IDENTITY_FILE=/root/.config/age/korean-study-backup.key
BACKUP_RCLONE_REMOTE=remote:korean-study-backups
BACKUP_RETENTION_DAYS=30
BACKUP_DOCKER_NETWORK=korean_study_app
MONGODB_TOOLS_IMAGE=mongodb/mongodb-database-tools:100.11.0
