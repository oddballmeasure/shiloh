# Copy to .env.production on the VPS, fill all values, then chmod 600 it.
DOMAIN=learn.example.com

MONGO_DB_NAME=korean_study
# Use the Atlas connection string for the production database user. URL-encode
# credentials if they contain reserved URI characters.
MONGO_URL=mongodb+srv://replace-with-a-uri-safe-username:replace-with-a-long-uri-safe-password@your-cluster.mongodb.net/korean_study?retryWrites=true&w=majority

JWT_SECRET=replace-with-at-least-32-random-bytes
INTERNAL_AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_DISCORD_ID=your-production-discord-client-id
AUTH_DISCORD_SECRET=your-production-discord-client-secret

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-mini
OCR_LANGUAGES=kor,eng
ASSIGNMENT_PDF_MAX_BYTES=52428800
